# @BotFather 에서 발급한 봇 토큰 (필수)
TELEGRAM_BOT_TOKEN=

# Google AI Studio (Gemini) API 키 (필수) — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 사용할 모델 (기본: gemini-flash-latest — 항상 최신 Flash를 가리키는 별칭)
# GEMINI_MODEL=gemini-flash-latest

# 오류 알림을 받을 관리자 chat id (선택) — 봇에 /id 를 보내면 확인 가능
ADMIN_CHAT_ID=

# SQLite 저장 경로 (기본: data/bot.db)
DB_PATH=data/bot.db

# 로그 레벨 (기본: INFO)
LOG_LEVEL=INFO
